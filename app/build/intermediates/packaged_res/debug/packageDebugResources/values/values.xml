<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="btn_number_bg">#2A2A2A</color>
    <color name="btn_operator_bg">#FF9F0A</color>
    <color name="btn_operator_text">#FFFFFF</color>
    <color name="btn_utility_bg">#A4A4A4</color>
    <color name="btn_utility_text">#000000</color>
    <color name="calc_background">#000000</color>
    <color name="calc_subtext">#9A9A9A</color>
    <color name="calc_text">#FFFFFF</color>
    <string name="app_name">Calculator</string>
    <style name="CalcButton.Base" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">26sp</item>
        <item name="cornerRadius">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="CalcButton.Number" parent="CalcButton.Base">
        <item name="android:backgroundTint">@color/btn_number_bg</item>
        <item name="android:textColor">@color/calc_text</item>
    </style>
    <style name="CalcButton.Operator" parent="CalcButton.Base">
        <item name="android:backgroundTint">@color/btn_operator_bg</item>
        <item name="android:textColor">@color/btn_operator_text</item>
    </style>
    <style name="CalcButton.Utility" parent="CalcButton.Base">
        <item name="android:backgroundTint">@color/btn_utility_bg</item>
        <item name="android:textColor">@color/btn_utility_text</item>
    </style>
    <style name="Theme.Magiscal" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>