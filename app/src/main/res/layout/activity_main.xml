<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_background"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/displayContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/keypadContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="0.32">

        <TextView
            android:id="@+id/expressionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end"
            android:maxLines="2"
            android:textColor="@color/calc_subtext"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/calc_text"
            android:textSize="56sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/keypadContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/displayContainer"
        app:layout_constraintVertical_weight="0.68">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAc"
                style="@style/CalcButton.Utility"
                android:onClick="onButtonClick"
                android:text="AC" />

            <Button
                android:id="@+id/btnSign"
                style="@style/CalcButton.Utility"
                android:onClick="onButtonClick"
                android:text="+/-" />

            <Button
                android:id="@+id/btnPercent"
                style="@style/CalcButton.Utility"
                android:onClick="onButtonClick"
                android:text="%" />

            <Button
                android:id="@+id/btnDivide"
                style="@style/CalcButton.Operator"
                android:onClick="onButtonClick"
                android:text="÷" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                style="@style/CalcButton.Number"
                android:onClick="onButtonClick"
                android:text="7" />

            <Button
                style="@style/CalcButton.Number"
                android:onClick="onButtonClick"
                android:text="8" />

            <Button
                style="@style/CalcButton.Number"
                android:onClick="onButtonClick"
                android:text="9" />

            <Button
                android:id="@+id/btnMultiply"
                style="@style/CalcButton.Operator"
                android:onClick="onButtonClick"
                android:text="×" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                style="@style/CalcButton.Number"
                android:onClick="onButtonClick"
                android:text="4" />

            <Button
                style="@style/CalcButton.Number"
                android:onClick="onButtonClick"
                android:text="5" />

            <Button
                style="@style/CalcButton.Number"
                android:onClick="onButtonClick"
                android:text="6" />

            <Button
                android:id="@+id/btnMinus"
                style="@style/CalcButton.Operator"
                android:onClick="onButtonClick"
                android:text="-" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                style="@style/CalcButton.Number"
                android:onClick="onButtonClick"
                android:text="1" />

            <Button
                style="@style/CalcButton.Number"
                android:onClick="onButtonClick"
                android:text="2" />

            <Button
                style="@style/CalcButton.Number"
                android:onClick="onButtonClick"
                android:text="3" />

            <Button
                android:id="@+id/btnPlus"
                style="@style/CalcButton.Operator"
                android:onClick="onButtonClick"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                style="@style/CalcButton.Number"
                android:onClick="onButtonClick"
                android:text="0" />

            <Button
                style="@style/CalcButton.Number"
                android:onClick="onButtonClick"
                android:text="." />

            <Button
                android:id="@+id/btnEquals"
                style="@style/CalcButton.Operator"
                android:onClick="onButtonClick"
                android:text="=" />

            <Button
                android:id="@+id/btnCe"
                style="@style/CalcButton.Utility"
                android:onClick="onButtonClick"
                android:text="C" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
